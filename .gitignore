# Dependencies
node_modules/
*/node_modules/

# Build outputs
build/
dist/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker volumes
postgres_data/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Design tooling: the config, the design sidecar and the critique snapshots are
# shared and belong in the repo. Everything below is per-machine runtime state.
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/config.local.json
.impeccable/live/

# Vendored agent skills -- installed per machine, not part of the app.
.claude/skills/
# Per-machine agent settings: tool permissions and hooks belong to whoever is
# sitting here, not to the tournament. Shared .claude/settings.json still is.
.claude/settings.local.json
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.png
*.PNG
*.jpg
*.jpeg
*.gif
*.bmp

# Backup files
*.bak
*backup*
*-backup.*
# Lockfile is committed deliberately: the old app had none, so every Docker
# build resolved a fresh dependency tree.
!package-lock.json

# Secrets — .env.production was previously committed to this public repo.
.env.*
!.env.example

# Internal drafts with staff names — not for a public repo.
docs/email-*.md

# Local dev environment
apps/api/.env
