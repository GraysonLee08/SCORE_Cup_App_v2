{
  "permissions": {
    "allow": [
      "Bash(docker-compose:*)",
      "Bash(npm install)",
      "Bash(curl:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker volume:*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_console_messages",
      "Bash(docker logs:*)",
      "mcp__playwright__browser_install",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_snapshot",
      "WebFetch(domain:www.chicagoscores.org)",
      "mcp__playwright__browser_resize",
      "Bash(npm start)",
      "Bash(npm cache clean:*)",
      "Bash(npm cache:*)",
      "Bash(npm install:*)",
      "Bash(docker run:*)",
      "Bash(node:*)",
      "Bash(dir:*)",
      "Bash(timeout 30 docker logs -f test-frontend)",
      "Bash(docker system prune:*)",
      "Bash(timeout 30 docker-compose logs -f tournament_frontend)",
      "Bash(docker exec:*)",
      "Bash(npm run build:*)",
      "Bash(docker build:*)",
      "Bash(mv:*)",
      "Skill(impeccable)",
      "Bash(python -c ' *)",
      "Bash(npm test *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write/MultiEdit on UI files, full-rule deep pass on Stop."
}
